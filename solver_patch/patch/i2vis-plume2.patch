+/*Jie: Transition type for initial T box*/
+void tkcalc1(double x, double y, double *eps1)
+{
+/*counters*/
+long int m1, m2, m3, m10, m20;
+int n1;
+/*coordinates, grid and marker-node distances*/
+double dx,dy,ddx,ddy,swt,ival;
+/**/
+m10=m1serch(x);
+m20=m2serch(y);
+dx=gx[m10+1]-gx[m10];
+dy=gy[m20+1]-gy[m20];
+/*initial tk*/
+eps1[0]=0;
+/**/
+n1=0;
+ival=0;
+for (m1=m10;m1<=m10+1;m1++)
+        {
+        /*normalized x distance*/
+        ddx=(gx[m1]-x)/dx;
+        ddx=1.0-ABSV(ddx);
+        for (m2=m20;m2<=m20+1;m2++)
+                {
+                /*normalized y distance*/
+                ddy=(gy[m2]-y)/dy;
+                ddy=1.0-ABSV(ddy);
+                /*Wt calculation*/
+                swt=ddx*ddy;
+                m3=m1*ynumy+m2;
+                /*add tk for current node*/
+                eps1[0]+=swt*tk[m3];
+                /*add Wt*/
+                ival+=swt;
+                /*add counter*/
+		 n1++;
+                }
+        }
+}
